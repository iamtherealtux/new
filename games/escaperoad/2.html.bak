<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport"
      content="width=device-width,initial-scale=1,user-scalable=no">

<title>Escape Road 2</title>

<style>
html, body {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #000;
}

#unity-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    background: #000;
}

#loading {
    position: fixed;
    inset: 0;
    z-index: 10;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    background: #000;
    color: #fff;
    font: 16px Arial, sans-serif;
}

#bar {
    width: min(500px, 60vw);
    height: 12px;
    margin-top: 14px;
    border: 1px solid #777;
}

#progress {
    width: 0%;
    height: 100%;
    background: #fff;
}
</style>
</head>

<body>

<canvas id="unity-canvas" tabindex="-1"></canvas>

<div id="loading">
    <div id="status">Starting Escape Road 2...</div>
    <div id="bar">
        <div id="progress"></div>
    </div>
</div>

<script>
const BASE =
    "https://play.1games.io/game/escape-road-2/25102308/";

const BUILD = BASE + "Build/";

const canvas   = document.getElementById("unity-canvas");
const loading  = document.getElementById("loading");
const status   = document.getElementById("status");
const progress = document.getElementById("progress");

const config = {
    dataUrl:
        BUILD + "escape-road-2-v25102308.data.unityweb",

    frameworkUrl:
        BUILD + "escape-road-2-v25102308.framework.js.unityweb",

    codeUrl:
        BUILD + "escape-road-2-v25102308.wasm.unityweb",

    streamingAssetsUrl:
        BASE + "StreamingAssets",

    companyName: "1games.io",
    productName: "Escape Road 2",
    productVersion: "25102308",

    showBanner: function(message, type) {
        console.log("[Unity " + type + "]", message);
    }
};

function loadScript(url) {
    return new Promise((resolve, reject) => {
        const script = document.createElement("script");
        script.src = url;

        script.onload = resolve;

        script.onerror = () => {
            reject(new Error("Failed to load Unity loader: " + url));
        };

        document.body.appendChild(script);
    });
}

window.firebaseLogEvent = function(...args) {
    console.log("[firebaseLogEvent]", ...args);
};

async function startGame() {
    status.textContent = "Loading Unity...";

    await loadScript(
        BUILD + "escape-road-2-v25102308.loader.js"
    );

    if (typeof createUnityInstance !== "function") {
        throw new Error(
            "Unity loader loaded, but createUnityInstance() is missing"
        );
    }

    status.textContent = "Loading Escape Road 2...";

    const unityInstance = await createUnityInstance(
        canvas,
        config,
        value => {
            const percent = Math.round(value * 100);

            progress.style.width = percent + "%";
            status.textContent =
                "Loading Escape Road 2... " + percent + "%";
        }
    );

    window.unityInstance = unityInstance;

    loading.style.display = "none";

    canvas.focus();
}

window.addEventListener("error", event => {
    console.error(
        "[window error]",
        event.message,
        event.filename,
        event.lineno,
        event.error
    );
});

window.addEventListener("unhandledrejection", event => {
    console.error(
        "[unhandled promise rejection]",
        event.reason
    );
});

startGame().catch(error => {
    console.error("Escape Road 2 startup failed:", error);

    status.textContent =
        "Escape Road 2 failed to load: " +
        (error && error.message ? error.message : String(error));
});
</script>

</body>
</html>
